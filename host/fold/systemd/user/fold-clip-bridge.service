# fold-ux10: Android <-> Omarchy clipboard (keeps host wayland-0 linked to Hyprland's socket so the
# AVF guest agent's wl-copy / wl-paste reach the desktop). See ~/fold-fix-tools/fold-clip-bridge.
# Install: systemctl --user daemon-reload; systemctl --user enable --now fold-clip-bridge
# Off: systemctl --user disable --now fold-clip-bridge   (wayland-0 returns to weston's socket at next VM boot)
[Unit]
Description=fold Android clipboard bridge (fold-ux10)

[Service]
ExecStart=%h/fold-fix-tools/fold-clip-bridge
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
