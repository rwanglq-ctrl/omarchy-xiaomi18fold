#!/bin/bash
# Installed by omarchy-alarm-nspawn. Private, read-only evidence; never restart.
set -u
umask 077
state="$HOME/.local/state/omarchy-alarm"
case ${1:-} in
  --stdout) [[ $# == 1 ]] || exit 2 ;;
  '')
    mkdir -p "$state" && chmod 700 "$state" || exit 1
    log=$(mktemp "$state/arch-diag-XXXXXXXX.log") || exit 1
    "$HOME/.local/bin/arch-log" --prune "$state"
    exec 3>&1 >"$log" 2>&1 ;;
  *) echo 'usage: arch-diag [--stdout]' >&2; exit 2 ;;
esac
bounded() { timeout --kill-after=1 3 "$@" 2>&1 || printf 'probe failed: %s\n' "$1"; }
echo 'omarchy-alarm-nspawn v@VERSION@ display diagnostics (private, unfiltered)'
date -u
uname -srmo
printf 'selected mode: '; cat "$HOME/.config/hypr-session-mode" 2>/dev/null || :
# start-hyprland waits only for a normal exit. When Hyprland dies from a signal
# before init it prints these two lines and returns 0, which looks clean.
# A manual run inspects the newest attempt; the session passes its own log.
attempt=${OMARCHY_SESSION_LOG:-$(ls -t "$state"/arch-session-*.log 2>/dev/null | head -1)}
if [[ -n $attempt ]] && grep -aq "Couldn't waitpid for hyprland: No child processes" "$attempt" 2>/dev/null; then
  echo "hyprland-signal-death: in ${attempt##*/}, Hyprland was killed by a signal before init; its \"exit cleanly\" is not a clean exit."
  echo 'SIGBUS/SIGKILL leave no crash report and lose the end of hyprland.log. Check the Mesa integrity line below first.'
fi
echo '--- staged Debian Mesa integrity (damaged copy => SIGBUS before init) ---'
if [[ -e $HOME/.config/arch-use-arch-mesa ]]; then
  echo 'not used: ~/.config/arch-use-arch-mesa selects Arch Mesa'
else
  # Exits 10-12 (damaged, operator-owned, absent) are results, not probe failures.
  timeout --kill-after=1 10 sudo -n python3 -I "$HOME/.local/bin/arch-mesa-check" --verify '@ROOTFS@/opt/debian-mesa' 2>&1 || :
fi
echo '--- Hyprland namespace logs and sockets (before all other probes) ---'
"$HOME/.local/bin/arch-output" --logs 2>&1 || echo 'namespace log probe failed'
echo '--- persistent Hyprland crash reports (snapshots; compare modification time to this attempt) ---'
bounded sudo -n chroot '@ROOTFS@' /bin/sh -c '
  reports=$(find "$1/.cache/hyprland" -maxdepth 1 -type f -name "hyprlandCrashReport*.txt" -printf "%T@ %p\n" 2>/dev/null | sort -rn | head -2)
  [ -n "$reports" ] || { echo "no Hyprland crash report found"; exit 0; }
  while IFS= read -r entry; do
    file=${entry#* }
    printf "\n--- %s ---\n" "$file"
    stat -c "modified: %y" "$file"
    tail -c 65536 "$file"
  done <<REPORTS
$reports
REPORTS
' arch-crashes '@CHOME@'
echo '--- machine identity (values withheld) ---'
bounded sudo -n bash "$HOME/.local/bin/arch-machine-id" --check '@ROOTFS@'
echo '--- display socket and service ---'
bounded systemctl --user show weston.socket -p ActiveState -p SubState -p Triggers -p Listen
bounded systemctl --user show weston.service -p ActiveState -p SubState -p MainPID -p ExecMainStatus -p Result -p ExecMainStartTimestamp -p NRestarts
echo '--- session lock / DRM users (PID and command) ---'
bounded sudo -n fuser -v /run/user/@UID@/omarchy-alarm-session.lock /dev/dri/card*
echo '--- DRM / seat / udmabuf ---'
ls -l /dev/dri /dev/udmabuf /run/seatd.sock /run/user/@UID@ 2>&1 || :
for f in /sys/class/drm/card*-*/status; do
  [[ -r $f ]] || continue
  printf '%s: ' "$f"; cat "$f"
done
echo '--- desktop machine ---'
bounded machinectl show arch-desktop -p Leader -p State -p RootDirectory -p Timestamp
echo '--- launcher knobs ---'
for knob in arch-software-rendering arch-no-modifiers arch-no-atomic arch-use-arch-mesa arch-hyprland-prefix; do
  [[ ! -e $HOME/.config/$knob ]] || printf '%s enabled\n' "$knob"
done
echo '--- connected DRM connectors ---'
"$HOME/.local/bin/arch-output" --connected 2>&1 || echo 'No connected connector'
echo '--- raw Hyprland instances (including invalid/empty responses) ---'
"$HOME/.local/bin/arch-output" --instances 2>&1 || echo 'No instance report / namespace probe failed'
echo '--- Hyprland monitors all ---'
"$HOME/.local/bin/arch-output" --all 2>&1 || echo 'No monitor report / probe failed'
echo '--- container packages / user ---'
"$HOME/.local/bin/arch-output" --info 2>&1 || echo 'container unavailable'
echo '--- Omarchy shell log (persistent container file) ---'
# A fixed file read, not a guest absolute symlink followed by the host.
bounded sudo -n chroot '@ROOTFS@' /usr/bin/tail -c 131072 '@CHOME@/.local/state/omarchy/shell.log'
echo '--- previous attempt paths only (not part of this launch; open separately) ---'
while IFS= read -r entry; do
  file=${entry#* }
  [[ -f $file && ! -L $file && $file != "${OMARCHY_SESSION_LOG:-}" ]] || continue
  printf 'previous-attempt: %s\n' "$file"
done < <(find "$state" -maxdepth 1 -type f -name 'arch-session-*.log' -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -4)
echo '--- historical display journal (this boot, last 128KiB; may include older versions/attempts) ---'
bounded journalctl --user -b -u weston.service -u weston.socket --no-pager -o short-monotonic | tail -c 131072 | sed 's/^/history: /'
echo '--- historical machine/nspawn system journal (this boot, last 128KiB) ---'
bounded sudo -n journalctl -b --no-pager -o short-monotonic -u systemd-machined.service -u machine-arch\\x2ddesktop.scope | tail -c 131072 | sed 's/^/history: /'
echo '--- historical machine journal (may be unavailable in a non-boot container) ---'
bounded sudo -n journalctl -M arch-desktop -b --no-pager -o short-monotonic | tail -c 131072 | sed 's/^/history: /'
echo '--- diagnostic snapshot complete ---'
[[ -z ${log:-} ]] || printf 'Diagnostics saved (private file; inspect before sharing): %s\n' "$log" >&3
