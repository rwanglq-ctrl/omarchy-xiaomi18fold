#!/bin/bash
# Installed by omarchy-alarm-nspawn (host/install.sh); @PLACEHOLDERS@ are filled in at install time.
# Run the Arch container's Hyprland directly on the display; seatd hands it DRM/input fds.
# SYSTEMD_NSPAWN_LOCK=0 lets archbox shells share the same rootfs concurrently.
# /tmp is shared so Debian X11 apps started via host-run find this XWayland.
# Debian Mesa is staged by host/install.sh to match the working Pad reference.
# `touch ~/.config/arch-use-arch-mesa` opts out for comparison.
# Direct invocations use the same owner, evidence and cleanup as the service.
if [[ ${OMARCHY_SESSION_INTERNAL:-} != 1 ]]; then
  exec "$HOME/.local/bin/hypr-session" --direct "$@"
fi
rootfs='@ROOTFS@'
stage() { printf 'stage=%s %s\n' "$1" "${*:2}" >&2; }
command -v sudo >/dev/null || { stage sudo-unavailable; exit 1; }
sudo -n true || { stage sudo-needs-password; exit 1; }
for path in /dev/dri /dev/udmabuf /dev/input /run/udev /run/seatd.sock /run/user/@UID@; do
  [[ -e $path ]] || { stage missing-device "$path"; exit 1; }
done
[[ -S /run/seatd.sock ]] || { stage seat-invalid 'not a socket'; exit 1; }
sudo -n bash "$HOME/.local/bin/arch-machine-id" "$rootfs" || { stage machine-id-invalid; exit 1; }
stage preflight-ok
# Gold reference uses driver autodetection and no AQ/LIBGL overrides. Keep
# explicit troubleshooting knobs, but do not force them on every launch.
renderer=""
software=auto; modifiers=auto; atomic=auto
[ ! -e "$HOME/.config/arch-software-rendering" ] || { software=1; renderer="--setenv=LIBGL_ALWAYS_SOFTWARE=1 --setenv=GALLIUM_DRIVER=llvmpipe"; }
[ ! -e "$HOME/.config/arch-no-modifiers" ] || { modifiers=1; renderer="$renderer --setenv=AQ_NO_MODIFIERS=1"; }
[ ! -e "$HOME/.config/arch-no-atomic" ] || { atomic=1; renderer="$renderer --setenv=AQ_NO_ATOMIC=1"; }
mesa=""
libpath=""
mesa_source=arch
if [ ! -e "$HOME/.config/arch-use-arch-mesa" ] && sudo -n test -e "$rootfs/opt/debian-mesa/lib/libgbm.so.1"; then
  mesa_source=debian
  libpath=/opt/debian-mesa/lib
  mesa="--setenv=GBM_BACKENDS_PATH=/opt/debian-mesa/lib/gbm
    --setenv=__EGL_VENDOR_LIBRARY_FILENAMES=/opt/debian-mesa/egl/50_debian_mesa.json"
fi
# Optional alternate Hyprland build: put its install prefix (container path, e.g.
# /opt/hyprland-0.55) in ~/.config/arch-hyprland-prefix. Delete the file for pacman's.
launch=/usr/bin/start-hyprland
prefix=$(cat "$HOME/.config/arch-hyprland-prefix" 2>/dev/null)
case "$prefix" in
  /*) case "$prefix" in *[!A-Za-z0-9/._-]*) prefix="" ;; esac ;;
  *) prefix="" ;;
esac
if [ -n "$prefix" ] && sudo -n test -x "$rootfs$prefix/bin/Hyprland"; then
  sudo -n test -x "$rootfs$prefix/bin/start-hyprland" || { stage prefix-watchdog-missing "$prefix"; exit 1; }
  launch="$prefix/bin/start-hyprland --path $prefix/bin/Hyprland"
  libpath="$prefix/lib${libpath:+:$libpath}"
  mesa="$mesa --setenv=PATH=$prefix/bin:/usr/local/sbin:/usr/local/bin:/usr/bin"
fi
[ -z "$libpath" ] || mesa="$mesa --setenv=LD_LIBRARY_PATH=$libpath"
sudo -n test -x "$rootfs${launch%% *}" || { stage start-hyprland-missing; exit 1; }
# Host home folders shared with the container (same files on both sides; the UID matches).
# Only folders that exist on the host are bound. Empty list = --no-home-binds.
homebinds=""
# shellcheck disable=SC2043  # the list is filled in at install time
for d in @HOME_BIND_DIRS@; do
  [ -d "@HOME@/$d" ] && homebinds="$homebinds --bind=@HOME@/$d:@CHOME@/$d"
done
if timeout --kill-after=1 2 machinectl show arch-desktop >/dev/null 2>&1; then
  stage registration-collision; exit 1
fi
# /dev/udmabuf: llvmpipe needs it for dmabuf export and EGL_ANDROID_native_fence_sync.
# Without it Hyprland loses explicit sync and the display shows torn/fragmented frames.
# Gold has no parent display and an unused Weston socket. Our host socket stays
# active for fallback, so hide only wayland-0 inside this container's mount
# namespace. With no WAYLAND_DISPLAY, the optional backend then fails promptly.
parent_mask=""
if [[ -e /run/user/@UID@/wayland-0 ]]; then
  parent_mask="--bind-ro=/dev/null:/run/user/@UID@/wayland-0"
fi
# Log choices in every launch mode, including selftest; auto means no override.
stage arch-hyprland "software=$software no_modifiers=$modifiers no_atomic=$atomic mesa=$mesa_source launch=$launch parent_mask=${parent_mask:+wayland-0}"
stage nspawn-start
# $mesa, $homebinds and $launch are intentionally unquoted so they split into separate words.
# shellcheck disable=SC2086
exec sudo -n SYSTEMD_NSPAWN_LOCK=0 systemd-nspawn -q -D "$rootfs" -M arch-desktop \
  --as-pid2 --kill-signal=SIGTERM --console=pipe --resolv-conf=off \
  -u '@USER@' --chdir='@CHOME@' \
  --bind=/dev/dri --bind=/dev/udmabuf --bind=/dev/input --bind-ro=/run/udev --bind=/run/seatd.sock \
  --bind=/run/user/@UID@ --bind=/tmp \
  $homebinds $parent_mask \
  --property=DeviceAllow='char-drm rw' --property=DeviceAllow='char-input rw' --property=DeviceAllow='/dev/udmabuf rw' \
  --setenv=HOME='@CHOME@' --setenv=USER='@USER@' --setenv=LOGNAME='@USER@' \
  --setenv=XDG_RUNTIME_DIR=/run/user/@UID@ \
  --setenv=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/@UID@/bus \
  --setenv=XDG_SESSION_TYPE=wayland --setenv=XDG_CURRENT_DESKTOP=Hyprland \
  --setenv=XDG_SESSION_DESKTOP=Hyprland --setenv=LIBSEAT_BACKEND=seatd \
  --setenv=LANG=en_US.UTF-8 $renderer $mesa \
  /bin/sh -c 'unset WAYLAND_DISPLAY WAYLAND_SOCKET; echo "stage=container-entry"; id; test -w "$XDG_RUNTIME_DIR" || { echo "stage=runtime-not-writable" >&2; exit 1; }; echo "stage=start-hyprland"; exec "$@"' arch-launch $launch "$@"
