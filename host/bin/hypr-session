#!/bin/sh
# Installed by omarchy-alarm-nspawn (host/install.sh); @PLACEHOLDERS@ filled at install.
# A running PID/socket is insufficient: require a usable non-fallback output via IPC.
stop_arch() {
  timeout --kill-after=1 3 sudo -n machinectl kill arch-desktop --kill-whom=all --signal=SIGTERM >/dev/null 2>&1 || :
  i=0
  while timeout 1 machinectl show arch-desktop >/dev/null 2>&1 && [ "$i" -lt 5 ]; do
    sleep 1; i=$((i+1))
  done
  if timeout 1 machinectl show arch-desktop >/dev/null 2>&1; then
    timeout --kill-after=1 3 sudo -n machinectl kill arch-desktop --kill-whom=all --signal=SIGKILL >/dev/null 2>&1 || :
    timeout --kill-after=1 3 sudo -n machinectl terminate arch-desktop >/dev/null 2>&1 || :
  fi
  kill "$child" 2>/dev/null || :
  # Do not contend for the DRM seat if container cleanup failed.
  ! timeout 1 machinectl show arch-desktop >/dev/null 2>&1
}
mode=$(cat "$HOME/.config/hypr-session-mode" 2>/dev/null || echo debian)
if [ "$mode" = arch ]; then
  if sudo -n test -x '@ROOTFS@/usr/bin/start-hyprland'; then
    old_leader=$(timeout --kill-after=1 2 machinectl show arch-desktop -p Leader --value 2>/dev/null || :)
    old_unknown=0
    case "$old_leader" in
      ''|*[!0-9]*)
        old_leader=''
        # Missing machine is normal. An existing machine with an unreadable
        # leader must not satisfy the new session's gate on a later retry.
        if timeout --kill-after=1 2 machinectl show arch-desktop >/dev/null 2>&1; then old_unknown=1; fi ;;
    esac
    "$HOME/.local/bin/arch-hyprland" &
    child=$!
    trap 'stop_arch; exit 143' TERM
    trap 'stop_arch; exit 130' INT
    ready=0
    deadline=$(( $(date +%s) + 30 ))
    while kill -0 "$child" 2>/dev/null && [ "$(date +%s)" -lt "$deadline" ]; do
      if [ "$old_unknown" = 0 ] && "$HOME/.local/bin/arch-output" --exclude-leader "$old_leader" >/dev/null 2>&1; then ready=1; break; fi
      sleep 1
    done
    if [ "$ready" = 1 ]; then
      wait "$child"
      result=$?
      trap - TERM INT
      exit "$result"
    fi
    if [ "$old_unknown" = 1 ]; then
      reason="has an unknown previous leader; cannot verify a fresh session"
    elif kill -0 "$child" 2>/dev/null; then
      reason="is alive but has no usable output"
    else
      reason="exited before establishing a usable output"
    fi
    echo "hypr-session: Arch $reason (startup deadline 30s); collecting diagnostics and falling back to Weston" >&2
    timeout --kill-after=1 20 "$HOME/.local/bin/arch-diag" >&2 || :
    if ! stop_arch; then
      echo "hypr-session: cannot release arch-desktop; refusing a competing compositor" >&2
      exit 1
    fi
    trap - TERM INT
  else
    echo "hypr-session: no Hyprland in Arch container, falling back to Weston" >&2
  fi
fi
# Weston is the known-working recovery path on Android Terminal, even if Debian
# also happens to have start-hyprland installed.
exec /usr/bin/weston --modules=systemd-notify.so --xwayland --continue-without-input
