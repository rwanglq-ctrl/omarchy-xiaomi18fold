#!/bin/bash
# Installed by omarchy-alarm-nspawn (host/install.sh); @PLACEHOLDERS@ filled at install.
# One owner, one persistent attempt log, bounded diagnostics before teardown.
set -u
# Keep systemd's activation socket away from logger stdout/stderr saves (3/4).
activation=0
if [[ ${LISTEN_PID:-} == "$$" && ${LISTEN_FDS:-} == 1 ]]; then
  exec 7<&3
  activation=1
fi
weston() {
  if (( activation )); then exec 3<&7 7<&-; fi
  exec /usr/bin/weston --modules=systemd-notify.so --xwayland --continue-without-input
}
state="$HOME/.local/state/omarchy-alarm"
owner="$state/desktop-owner"
child=''; owned=0; finished=0; selftest=0; direct=0; log=''; logger=''; stop_rc=0
stage() { printf 'stage=%s time=%s %s\n' "$1" "$(date -u +%FT%TZ)" "${*:2}"; }
show_machine() { timeout --kill-after=1 2 machinectl show arch-desktop "$@"; }
# Linux uptime is independent of wall-clock/NTP changes. Bash SECONDS is not.
monotonic_seconds() {
  local uptime
  read -r uptime _ < /proc/uptime || return 1
  printf '%s\n' "${uptime%%.*}"
}
before_deadline() {
  local now
  now=$(monotonic_seconds) || return 1
  (( now < $1 ))
}
# A transient machined activation delay must not strand the default desktop.
list_machines() {
  local attempt result
  for attempt in 1 2 3; do
    if result=$(timeout --kill-after=1 2 machinectl list --no-legend --no-pager 2>/dev/null); then
      printf '%s\n' "$result"; return 0
    fi
    (( attempt == 3 )) || sleep 1
  done
  return 1
}
close_log() {
  [[ -n $logger ]] || return 0
  exec 1>&3 2>&4
  local end status
  end=$(($(monotonic_seconds) + 5))
  while kill -0 "$logger" 2>/dev/null; do
    # An exited, not-yet-reaped child still responds to kill -0.
    read -r status < "/proc/$logger/stat" 2>/dev/null || break
    [[ $status != *") Z "* ]] || break
    if ! before_deadline "$end"; then
      echo 'log-drain-incomplete: a writer still holds the capture pipe' >&2
      kill -KILL "$logger" 2>/dev/null || :
      break
    fi
    sleep 0.1
  done
  wait "$logger" 2>/dev/null || :
  logger=''
}
stop_arch() {
  # ExecStopPost may only clean the machine belonging to this service invocation.
  [[ -n ${token:-} && -f $owner && $(cat "$owner") == "$token" ]] || return 0
  stage cleanup-begin
  if show_machine >/dev/null 2>&1; then
    timeout --kill-after=1 3 sudo -n machinectl kill arch-desktop --kill-whom=all --signal=SIGTERM || stage cleanup-term-failed
    end=$(($(monotonic_seconds) + 3))
    while before_deadline "$end"; do show_machine >/dev/null 2>&1 || break; sleep 0.2; done
    if show_machine >/dev/null 2>&1; then
      timeout --kill-after=1 3 sudo -n machinectl kill arch-desktop --kill-whom=all --signal=SIGKILL || stage cleanup-kill-failed
      timeout --kill-after=1 3 sudo -n machinectl terminate arch-desktop || stage cleanup-terminate-failed
    fi
    end=$(($(monotonic_seconds) + 3))
    while before_deadline "$end"; do show_machine >/dev/null 2>&1 || break; sleep 0.2; done
  fi
  [[ -z $child ]] || kill "$child" 2>/dev/null || :
  # A failed registry query is not proof of a free seat: verify the bus too.
  machines=$(list_machines) || { stage cleanup-registry-unavailable; return 1; }
  if grep -q '^arch-desktop[[:space:]]' <<< "$machines"; then
    stage cleanup-failed 'refusing a competing compositor'; return 1
  fi
  rm -f -- "$owner"
  owned=0
  stage cleanup-complete
}
if [[ ${1:-} == --cleanup ]]; then
  [[ $# == 1 && -n ${INVOCATION_ID:-} ]] || exit 0
  token=$INVOCATION_ID
  stop_arch
  exit $?
fi
case ${1:-} in
  --selftest) selftest=1; shift ;;
  --direct) direct=1; shift ;;
  '') ;;
  *) echo 'usage: hypr-session [--selftest|--direct]' >&2; exit 2 ;;
esac
if (( ! direct && $# )); then exit 2; fi
# Kernel flock is authoritative. Never unlink its inode: inherited descriptors
# can keep a real lock alive after the recorded launcher PID has died.
runtime=/run/user/@UID@
if [[ ! -d $runtime || ! -O $runtime ]]; then echo 'runtime-invalid: missing or wrong owner' >&2; exit 2; fi
lock="$runtime/omarchy-alarm-session.lock"
report_users() {
  local file pids pid
  for file in "$lock" /dev/dri/card*; do
    [[ -e $file ]] || continue
    pids=$(exec 8>&- 7<&-; timeout --kill-after=1 3 sudo -n fuser "$file" 2>/dev/null || :)
    for pid in $pids; do
      [[ $pid =~ ^[0-9]+$ && $pid != "$$" ]] || continue
      printf 'seat-user: file=%s pid=%s cmdline=' "$file" "$pid" >&2
      timeout --kill-after=1 2 ps -p "$pid" -o args= >&2 || :
    done
  done
  timeout --kill-after=1 2 systemctl --user show weston.socket weston.service -p Id -p ActiveState -p SubState -p MainPID >&2 || :
  timeout --kill-after=1 2 machinectl show arch-desktop -p Leader -p State >&2 || :
}
exec 8>>"$lock" || exit 2
end=$(($(monotonic_seconds) + 15))
while ! flock -n 8; do
  if (( ! selftest )) || ! before_deadline "$end"; then
    echo 'session-busy: live kernel lock; waiting for its owner did not free the seat (no process killed)' >&2
    report_users; exit 2
  fi
  sleep 0.2
done
old_pid=$(cat "$lock" 2>/dev/null || :)
if [[ $old_pid =~ ^[0-9]+$ ]] && ! kill -0 "$old_pid" 2>/dev/null && [[ ! -d /proc/$old_pid ]]; then
  echo "session-stale: clearing dead PID $old_pid metadata under the acquired lock" >&2
fi
# Clear stale metadata only with exclusive ownership; preserve the inode.
printf '%s\n' "$$" > "$lock"
mode=$(cat "$HOME/.config/hypr-session-mode" 2>/dev/null || echo debian)
(( selftest || direct )) && mode=arch
if (( selftest || direct )); then
  end=$(($(monotonic_seconds) + 15))
  while :; do
    status=$(timeout --kill-after=1 2 systemctl --user is-active weston.service 2>/dev/null || :)
    busy=''
    case "$status" in active|activating|deactivating|reloading) busy=display-active ;; esac
    if timeout --kill-after=1 3 sudo -n fuser -s /dev/dri/card*; then busy=seat-busy; fi
    machines=$(list_machines) || { echo 'registry-unavailable: cannot determine whether a desktop is running' >&2; exit 2; }
    if grep -q '^arch-desktop[[:space:]]' <<< "$machines"; then busy=registration-collision; fi
    [[ -n $busy ]] || break
    if (( ! selftest )) || ! before_deadline "$end"; then
      echo "$busy: seat did not become free; refusing an unrelated live owner (no process killed)" >&2
      report_users; exit 2
    fi
    sleep 0.2
  done
else
  machines=$(list_machines) || { echo 'registry-unavailable: cannot determine whether a desktop is running' >&2; exit 2; }
  if grep -q '^arch-desktop[[:space:]]' <<< "$machines"; then
    echo 'registration-collision: arch-desktop already exists; refusing an unowned machine' >&2; report_users; exit 2
  fi
fi
if [[ $mode != arch ]]; then
  weston
fi
umask 077
mkdir -p "$state" && chmod 700 "$state" || exit 1
log=$(mktemp "$state/arch-session-XXXXXXXX.log") || exit 1
exec 3>&1 4>&2
printf 'Session evidence: %s\n' "$log" >&4
exec > >(exec 8>&- 7<&-; "$HOME/.local/bin/arch-log" "$log") 2>&1
logger=$!
trap close_log EXIT
export OMARCHY_SESSION_LOG=$log
# Invocation IDs scope the service's last-resort cleanup; direct runs get a PID token.
token=${INVOCATION_ID:-direct-$$}
finish() {
  local rc=$1 why=$2
  trap 'stop_rc=129' HUP
  trap 'stop_rc=130' INT
  trap 'stop_rc=143' TERM
  trap 'stop_rc=124' USR1
  (( finished == 0 )) || return 0
  finished=1
  stage "$why" "exit=$rc"
  stage diagnostics-begin 'next block contains diagnostic snapshots and historical journal'
  timeout --kill-after=1 20 "$HOME/.local/bin/arch-diag" --stdout 8>&- 7<&- || stage diagnostics-incomplete
  if (( owned )); then stop_arch || rc=1; fi
  (( stop_rc == 0 )) || rc=$stop_rc
  if (( ! selftest && ! direct && ! owned && stop_rc == 0 )) && [[ $why == gate-timeout || $why == launcher-exit ]]; then
    stage fallback-Weston
  fi
  close_log
  (( stop_rc == 0 )) || rc=$stop_rc
  if (( selftest )); then printf '%s\n' "$log" >&3; fi
  return "$rc"
}
on_signal() {
  local rc=$1 why=$2
  finish "$rc" "$why"; rc=$?
  exit "$rc"
}
trap 'on_signal 129 signal-HUP' HUP
trap 'on_signal 130 signal-INT' INT
trap 'on_signal 143 signal-TERM' TERM
trap 'on_signal 124 selftest-timeout' USR1
stage session-start "selftest=$selftest direct=$direct version=@VERSION@ pid=$$ attempt=${log##*/}"
for component in hypr-session arch-hyprland arch-output arch-diag arch-selftest; do
  sha256sum "$HOME/.local/bin/$component"
done
printf '%s\n' "$token" > "$owner" || exit 1
owned=1
OMARCHY_SESSION_INTERNAL=1 "$HOME/.local/bin/arch-hyprland" "$@" 8>&- 7<&- &
child=$!
ready=0; registered=0
stage launcher-start "pid=$child"
# The readiness deadline uses the same monotonic clock as cleanup.
deadline=$(($(monotonic_seconds) + 30))
while kill -0 "$child" 2>/dev/null && before_deadline "$deadline"; do
  leader=$(show_machine -p Leader --value 2>/dev/null || :)
  if [[ $leader =~ ^[0-9]+$ && $leader -gt 1 ]] && (( ! registered )); then
    registered=1
    stage registration-observed "leader=$leader"
  fi
  if "$HOME/.local/bin/arch-output" >/dev/null; then ready=1; break; fi
  sleep 1
done
if (( ready )); then
  stage output-ready "leader=${leader:-unknown}"
  if (( selftest )); then
    sleep 3
    if "$HOME/.local/bin/arch-output" >/dev/null; then
      finish 0 selftest-ready; exit $?
    fi
    finish 1 output-lost; exit $?
  fi
  wait "$child"; result=$?
  finish "$result" session-ended; exit $?
fi
if kill -0 "$child" 2>/dev/null; then
  reason=gate-timeout; result=1
else
  wait "$child"; result=$?
  # A short-lived container can register, enter and exit between two polls.
  # Not observing Leader is NOT proof that registration failed. Preserve the
  # actual wait status before converting an early clean exit into gate failure.
  stage launcher-status "pid=$child status=$result registration_observed=$registered readiness=0"
  (( result != 0 )) || result=1
  reason=launcher-exit
fi
finish "$result" "$reason"; result=$?
if (( selftest || direct )); then exit "$result"; fi
if (( owned )); then exit 1; fi
(( stop_rc == 0 )) || exit "$stop_rc"
trap - HUP INT TERM USR1
weston
