#!/bin/sh
# Installed by omarchy-alarm-nspawn (host/install.sh).
# Select the next display session. Restarting weston can kill Android Terminal itself.
case "$1" in
  arch|debian) ;;
  *) echo "usage: hypr-switch arch|debian [--now]" >&2; exit 2 ;;
esac
case "$#:$2" in 1:|2:--now) ;; *) echo "usage: hypr-switch arch|debian [--now]" >&2; exit 2 ;; esac
mkdir -p "$HOME/.config"
modefile=$(mktemp "$HOME/.config/hypr-session-mode.XXXXXXXX") || exit 1
trap 'rm -f "$modefile"' 0
trap 'exit 1' HUP INT TERM
printf '%s\n' "$1" > "$modefile" && mv -f "$modefile" "$HOME/.config/hypr-session-mode" || exit 1
echo "next desktop start: $1"
if [ "$2" = --now ]; then
  echo "hypr-switch: --now deferred: restarting weston.service can close the Android Terminal app. Close/reopen its display to apply; use an independent SSH shell for recovery." >&2
fi
exit 0
